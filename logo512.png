// Part 1: New node #1 - API Call Node
import { useState } from 'react';
import { BaseNode } from './BaseNode';

export const APICallNode = ({ id, data }) => {
  const [method, setMethod] = useState(data?.method || 'GET');
  const [url, setUrl] = useState(data?.url || '');

  const inputStyle = {
    width: '100%', padding: '5px 8px', borderRadius: 6,
    border: '1px solid #c4b5fd', fontSize: 12, outline: 'none',
    background: '#fff', boxSizing: 'border-box', marginTop: 3,
  };

  return (
    <BaseNode
      id={id}
      nodeType="apiCall"
      title="API Call"
      inputs={[{ id: `${id}-body`, label: 'body' }, { id: `${id}-headers`, label: 'headers' }]}
      outputs={[{ id: `${id}-response`, label: 'response' }, { id: `${id}-status`, label: 'status' }]}
    >
      <div style={{ display: 'flex', flexDirection: 'column', gap: 6 }}>
        <label style={{ fontSize: 11, color: '#6b7280', fontWeight: 500 }}>
          Method
          <select style={{ ...inputStyle, cursor: 'pointer' }} value={method} onChange={(e) => setMethod(e.target.value)}>
            <option>GET</option><option>POST</option><option>PUT</option><option>DELETE</option>
          </select>
        </label>
        <label style={{ fontSize: 11, color: '#6b7280', fontWeight: 500 }}>
          URL
          <input style={inputStyle} type="text" value={url} onChange={(e) => setUrl(e.target.value)} placeholder="https://api.example.com/..." />
        </label>
      </div>
    </BaseNode>
  );
};
